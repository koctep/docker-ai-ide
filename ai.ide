 #!/bin/bash

case $(basename $_ .ide) in
  zed)
    CMD='zed --foreground .'
    ;;
  cursor)
    CMD='cursor .'
    ;;
  vscode)
    CMD='/usr/share/code/bin/code --verbose .'
    ;;
  *)
    CMD=bash
    ;;
esac
RUNCMD=${@:-${CMD}}
AI_PROFILE=${AI_PROFILE:-default}
PRJ=$(basename ${PWD})

[ -z $AI_PROFILE ] && echo "no profile defined" && exit 1
PROFILE_DIR=${HOME}/.local/share/ai-ide/${AI_PROFILE}
mkdir -p $PROFILE_DIR/src
SHARED_DIR=${HOME}/.local/share/ai-ide/shared
CONFIG_DIR=$HOME/.config/ai-ide/$AI_PROFILE/$PRJ
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/ai-ide/$AI_PROFILE/$PRJ
# Per-session /tmp on the host so agent scratch stays off the container overlay
TMP_HOST=${HOME}/.local/share/ai-ide/tmp/$$
mkdir -p $TMP_HOST
chmod 700 $TMP_HOST
trap 'rm -rf "$TMP_HOST"' EXIT

# Launcher configuration. The file is sourced by this script only, it is neither
# mounted into the container nor passed to it as environment variables.
if [ -e $CONFIG_DIR/.env ]; then
  echo "loading configuration from '$CONFIG_DIR/.env'" >&2
  . $CONFIG_DIR/.env
else
  echo "no env file in $CONFIG_DIR" >&2
fi

if [ ! -z ${AI_USE_PROXY} ]; then
  PROXY_IP=$(ip route get 8.8.8.8 | head -n 1 | awk '{print $7}')
  OPTS="$OPTS -e ALL_PROXY=socks5h://${PROXY_IP}:5020"
fi

# Detect OS
OS="$(uname -s)"
case "${OS}" in
  Linux*)
    IS_LINUX=true
    ;;
  Darwin*)
    IS_MACOS=true
    ;;
  *)
    ;;
esac

# Build docker run command with proper environment variable handling
DOCKER_CMD="docker run -it --rm"
DOCKER_CMD="$DOCKER_CMD --cap-add SYS_ADMIN"

# macOS: add network mode for X11 access
if [ "$IS_MACOS" = true ]; then
  # Use host network access for X11 on macOS
  DOCKER_CMD="$DOCKER_CMD --add-host=host.docker.internal:host-gateway"
  # Disable X11 authorization for Docker connections
  DOCKER_CMD="$DOCKER_CMD -e QT_X11_NO_MITSHM=1"
  DOCKER_CMD="$DOCKER_CMD -e _X11_NO_MITSHM=1"
  DOCKER_CMD="$DOCKER_CMD -e _MITSHM=0"
  # macOS: use host.docker.internal for X11 (requires XQuartz)
  # Check if XQuartz is running
  if ! pgrep -x "Xquartz" > /dev/null; then
    echo "Warning: XQuartz is not running. GUI applications may not work."
    echo "Please start XQuartz and enable 'Allow connections from network clients' in Preferences > Security"
  else
    # Verify XQuartz is listening on port 6000
    if ! lsof -i :6000 >/dev/null 2>&1; then
      echo "Warning: XQuartz is running but not listening on port 6000."
      echo "Make sure XQuartz was started with -listen tcp option"
    fi
  fi

  # Get host IP for X11 connection
  # XQuartz sets DISPLAY to a launchd unix socket (/private/tmp/.../org.xquartz:0)
  # which does not exist inside the container; keep it for local xhost/xauth calls
  # but treat it as unset so we fall back to host.docker.internal:0
  HOST_DISPLAY=${DISPLAY:-:0}
  case "$DISPLAY" in
    /*) DISPLAY= ;;
  esac

  if [ -z "$DISPLAY" ]; then
    # Use host.docker.internal for Docker Desktop on macOS (most reliable)
    # Fallback to actual IP if needed
    HOST_IP="host.docker.internal"
    DISPLAY_VAR="${HOST_IP}:0"

    # Allow X11 connections from Docker
    # Find xhost (usually in /opt/X11/bin on macOS)
    XHOST_CMD=$(command -v xhost 2>/dev/null)
    [ -z "$XHOST_CMD" ] && [ -x /opt/X11/bin/xhost ] && XHOST_CMD=/opt/X11/bin/xhost
    if [ -n "$XHOST_CMD" ]; then
      # Set DISPLAY for xhost (needed on macOS)
      export DISPLAY="$HOST_DISPLAY"
      # Allow all connections (for Docker, this is acceptable since it's local)
      # More secure: xhost +localhost +host.docker.internal
      "$XHOST_CMD" + >/dev/null 2>&1 || {
        # If that fails, try specific hosts
        "$XHOST_CMD" +localhost >/dev/null 2>&1
        "$XHOST_CMD" +host.docker.internal >/dev/null 2>&1 || true
        # Get actual IP and allow it too
        ACTUAL_IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "")
        [ -n "$ACTUAL_IP" ] && "$XHOST_CMD" +"$ACTUAL_IP" >/dev/null 2>&1 || true
        # Allow Docker network range
        "$XHOST_CMD" +172.16.0.0/12 >/dev/null 2>&1 || true
      }
    fi

    # Also try to copy X11 auth cookie (more secure, but xhost should be enough)
    XAUTH_CMD=$(command -v xauth 2>/dev/null)
    [ -z "$XAUTH_CMD" ] && [ -x /opt/X11/bin/xauth ] && XAUTH_CMD=/opt/X11/bin/xauth
    if [ -f "$HOME/.Xauthority" ] && [ -n "$XAUTH_CMD" ]; then
      XAUTH_FILE="/tmp/.docker.xauth.$$"
      touch "$XAUTH_FILE"
      chmod 600 "$XAUTH_FILE"
      # Try to extract auth for current display or :0
      CURRENT_DISPLAY=$HOST_DISPLAY
      "$XAUTH_CMD" -f "$HOME/.Xauthority" nlist "$CURRENT_DISPLAY" 2>/dev/null | sed -e 's/^..../ffff/' | "$XAUTH_CMD" -f "$XAUTH_FILE" nmerge - 2>/dev/null || {
        # Try with host.docker.internal
        "$XAUTH_CMD" -f "$HOME/.Xauthority" nlist "$CURRENT_DISPLAY" 2>/dev/null | sed -e "s/^..../ffff/" -e "s/unix:.*/inet host.docker.internal/" | "$XAUTH_CMD" -f "$XAUTH_FILE" nmerge - 2>/dev/null || true
      }
      if [ -s "$XAUTH_FILE" ]; then
        DOCKER_CMD="$DOCKER_CMD -v ${XAUTH_FILE}:/root/.Xauthority"
        DOCKER_CMD="$DOCKER_CMD -e XAUTHORITY=/root/.Xauthority"
      else
        rm -f "$XAUTH_FILE"
      fi
    fi
  else
    DISPLAY_VAR=${DISPLAY}
  fi
  DBUS_ADDR="unix:path=/tmp/dbus-session"
fi

# Linux-specific device and group settings
if [ "$IS_LINUX" = true ]; then
  # Add graphics device (Linux only)
  [ -d /dev/dri ] && DOCKER_CMD="$DOCKER_CMD --device=/dev/dri"

  # Add group IDs (Linux only)
  if command -v getent >/dev/null 2>&1; then
    RENDER_GID=$(getent group render | cut -d: -f3)
    [ -n "$RENDER_GID" ] && DOCKER_CMD="$DOCKER_CMD --group-add $RENDER_GID"

    VIDEO_GID=$(getent group video | cut -d: -f3)
    [ -n "$VIDEO_GID" ] && DOCKER_CMD="$DOCKER_CMD --group-add $VIDEO_GID"

    AUDIO_GID=$(getent group audio | cut -d: -f3)
    [ -n "$AUDIO_GID" ] && DOCKER_CMD="$DOCKER_CMD --group-add $AUDIO_GID"
  fi

  # Add audio device (Linux only)
  [ -d /dev/snd ] && DOCKER_CMD="$DOCKER_CMD --device=/dev/snd"
  # Linux: use Unix socket for X11. /tmp/.X11-unix is mounted after the
  # session /tmp bind below, otherwise that bind would hide the socket.
  DOCKER_CMD="$DOCKER_CMD -v /run/user/$UID/bus:/run/user/$UID/bus"
  DOCKER_CMD="$DOCKER_CMD -v /run/dbus:/run/dbus"
  DISPLAY_VAR=${DISPLAY:-:0}
  DBUS_ADDR="unix:path=/run/user/$UID/bus"
fi
DOCKER_CMD="$DOCKER_CMD -u $UID:44"

DOCKER_CMD="$DOCKER_CMD -v ${PROFILE_DIR}:/home"
[ -d ${SHARED_DIR} ] && DOCKER_CMD="$DOCKER_CMD -v ${SHARED_DIR}:/home/shared"
DOCKER_CMD="$DOCKER_CMD -v ${TMP_HOST}:/tmp"
DOCKER_CMD="$DOCKER_CMD -v ${TMP_HOST}:/var/tmp"
[ "$IS_LINUX" = true ] && DOCKER_CMD="$DOCKER_CMD -v /tmp/.X11-unix:/tmp/.X11-unix"
DOCKER_CMD="$DOCKER_CMD -v ${PWD}:/home/src"
DOCKER_CMD="$DOCKER_CMD -w /home/src"
DOCKER_CMD="$DOCKER_CMD -e DISPLAY=${DISPLAY_VAR}"
DOCKER_CMD="$DOCKER_CMD -e HOME=/home"
DOCKER_CMD="$DOCKER_CMD -e TMPDIR=/tmp"
DOCKER_CMD="$DOCKER_CMD -e LANG=en_US.UTF-8 -e LC_ALL=en_US.UTF-8"
DOCKER_CMD="$DOCKER_CMD -e DBUS_SESSION_BUS_ADDRESS=${DBUS_ADDR}"
echo "mounting config files from '$CONFIG_DIR'" >&2
[ -d $CONFIG_DIR ] && \
for f in $(cd $CONFIG_DIR && find . -type f | sed 's|^\./||' \
           | grep -vE '^(\.env|\.exports|mcp\.json|config\.toml)$'); do
  echo "  $f" >&2
  mkdir -p $PROFILE_DIR/$(dirname $f)
  DOCKER_CMD="$DOCKER_CMD -v $CONFIG_DIR/$f:/home/$f:ro"
done

# Variables passed into the container: one NAME=value per line, or a bare NAME
# to forward the value from the host environment
if [ -e $CONFIG_DIR/.exports ]; then
  echo "exporting variables from '$CONFIG_DIR/.exports'" >&2
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    echo "  ${line%%=*}" >&2
    DOCKER_CMD="$DOCKER_CMD -e \"$line\""
  done < $CONFIG_DIR/.exports
else
  echo "no exports file in $CONFIG_DIR" >&2
fi

# MCP servers. A single mcp.json is mounted read-only under every name the
# agents expect; codex reads toml, so its config is generated from the same file
# (on top of $CONFIG_DIR/config.toml, when that one exists) and mounted as the
# managed config: ~/.codex/config.toml has to stay writable, codex persists the
# directory trust into it.
MCP_TARGETS=${AGENT_MCP_TARGETS:-".mcp.json .cursor/mcp.json .agents/mcp_config.json .gemini/config/mcp_config.json"}
if [ -e $CONFIG_DIR/mcp.json ]; then
  echo "mounting mcp config from '$CONFIG_DIR/mcp.json'" >&2
  for target in $MCP_TARGETS; do
    echo "  /home/$target" >&2
    mkdir -p $PROFILE_DIR/$(dirname $target)
    DOCKER_CMD="$DOCKER_CMD -v $CONFIG_DIR/mcp.json:/home/$target:ro"
  done

  mkdir -p $CACHE_DIR
  cat > $CACHE_DIR/mcp2toml.py <<'MCP2TOML'
"""Convert the mcpServers section of an mcp.json into codex config.toml tables"""
import json
import re
import sys

with open(sys.argv[1]) as f:
    config = json.load(f)
servers = config.get("mcpServers") or config.get("servers") or {}


def string(value):
    return json.dumps(str(value))


def key(name):
    return name if re.fullmatch(r"[A-Za-z0-9_-]+", name) else string(name)


def array(values):
    return "[" + ", ".join(string(v) for v in values) + "]"


def table(values):
    return "{ " + ", ".join(
        "%s = %s" % (key(k), string(v)) for k, v in values.items()
    ) + " }"


out = []
for name, server in servers.items():
    fields = []
    if server.get("command"):
        fields.append(("command", string(server["command"])))
    if server.get("args"):
        fields.append(("args", array(server["args"])))
    if server.get("env"):
        fields.append(("env", table(server["env"])))
    if server.get("url"):
        fields.append(("url", string(server["url"])))
    if server.get("headers"):
        fields.append(("http_headers", table(server["headers"])))
    if server.get("startup_timeout_sec"):
        fields.append(("startup_timeout_sec", server["startup_timeout_sec"]))
    if server.get("enabled") is False:
        fields.append(("enabled", "false"))
    if not fields:
        continue
    out.append("[mcp_servers.%s]" % key(name))
    out += ["%s = %s" % field for field in fields]
    out.append("")

sys.stdout.write("\n".join(out))
MCP2TOML

  {
    [ -e $CONFIG_DIR/config.toml ] && cat $CONFIG_DIR/config.toml && echo
    if command -v python3 >/dev/null 2>&1; then
      python3 $CACHE_DIR/mcp2toml.py $CONFIG_DIR/mcp.json
    else
      # no python on the host, use the one from the image
      docker run --rm -v "$CACHE_DIR":/cache:ro -v "$CONFIG_DIR":/config:ro ai-ide \
        python3 /cache/mcp2toml.py /config/mcp.json
    fi
  } > $CACHE_DIR/managed_config.toml.tmp \
  && mv $CACHE_DIR/managed_config.toml.tmp $CACHE_DIR/managed_config.toml \
  && echo "  /etc/codex/managed_config.toml (generated in $CACHE_DIR)" >&2 \
  && DOCKER_CMD="$DOCKER_CMD -v $CACHE_DIR/managed_config.toml:/etc/codex/managed_config.toml:ro" \
  || echo "  failed to generate the codex config" >&2
  rm -f $CACHE_DIR/managed_config.toml.tmp
else
  echo "no mcp.json in $CONFIG_DIR" >&2
fi

# Mount agent skills read-only. AGENT_SKILLS is a list of skills separated by
# colons, spaces or newlines; every entry is a skill (a directory with SKILL.md)
# or a directory holding several of them, globs and $HOME relative paths work.
#
# Skill directories of every agent installed in the image, relative to /home.
# Nothing is mounted into src, the project keeps its own layout; agy sees the
# gemini pair instead of the workspace .agents/skills it also supports
SKILLS_TARGETS=${AGENT_SKILLS_TARGETS:-".agents/skills .claude/skills .cursor/skills .gemini/skills .gemini/antigravity-cli/skills"}
MOUNTED_SKILLS=

mount_skill() {
  SKILL_SRC=${1%/}
  SKILL_NAME=$(basename "$SKILL_SRC")
  case " $MOUNTED_SKILLS " in
    *" $SKILL_NAME "*)
      echo "  skipping '$SKILL_SRC': '$SKILL_NAME' is already mounted" >&2
      return
      ;;
  esac
  MOUNTED_SKILLS="$MOUNTED_SKILLS $SKILL_NAME"
  echo "  $SKILL_NAME ($SKILL_SRC)${2:+ $2}" >&2
  for target in $SKILLS_TARGETS; do
    DOCKER_CMD="$DOCKER_CMD -v \"$SKILL_SRC\":/home/$target/\"$SKILL_NAME\":ro"
  done
}

if [ ! -z "${AGENT_SKILLS}" ]; then
  echo "mounting skills from '$AGENT_SKILLS'" >&2
  # docker creates missing mount points as root, so prepare the tree ourselves
  for target in $SKILLS_TARGETS; do
    case $target in
      # /home/src is the project, not the profile
      src/*) mkdir -p ${PWD}/${target#src/} ;;
      *) mkdir -p $PROFILE_DIR/$target ;;
    esac
  done
  OLD_IFS=$IFS
  IFS=$': \t\n'
  for entry in $AGENT_SKILLS; do
    [ -z "$entry" ] && continue
    # the value keeps ~ and globs literal when it comes from a quoted assignment
    case "$entry" in
      '~/'*) entry=$HOME/${entry#\~/} ;;
    esac
    for skill_dir in $entry; do
      if [ ! -d "$skill_dir" ]; then
        echo "  skipping '$skill_dir': not a directory" >&2
        continue
      fi
      if [ -f "${skill_dir%/}/SKILL.md" ]; then
        mount_skill "$skill_dir"
        continue
      fi
      found=
      for skill in "${skill_dir%/}"/*/; do
        [ -f "${skill}SKILL.md" ] && found=yes
      done
      if [ ! -z "$found" ]; then
        # a directory of skills: mount everything it holds, so that the files
        # skills share between themselves (../_shared and friends) stay reachable
        for skill in "${skill_dir%/}"/*/; do
          [ -d "$skill" ] || continue
          if [ -f "${skill}SKILL.md" ]; then
            mount_skill "$skill"
          else
            mount_skill "$skill" "[shared files]"
          fi
        done
      else
        mount_skill "$skill_dir" "[shared files]"
      fi
    done
  done
  IFS=$OLD_IFS
fi

[ ! -z "${DEBUG}" ] && echo "running $DOCKER_CMD" >&2

# Add git environment variables if they exist
[ ! -z "${GIT_AUTHOR_NAME}" ] && DOCKER_CMD="$DOCKER_CMD -e GIT_AUTHOR_NAME=\"${GIT_AUTHOR_NAME}\""
[ ! -z "${GIT_AUTHOR_EMAIL}" ] && DOCKER_CMD="$DOCKER_CMD -e GIT_AUTHOR_EMAIL=\"${GIT_AUTHOR_EMAIL}\""
[ ! -z "${GIT_COMMITTER_NAME}" ] && DOCKER_CMD="$DOCKER_CMD -e GIT_COMMITTER_NAME=\"${GIT_COMMITTER_NAME}\""
[ ! -z "${GIT_COMMITER_EMAIL}" ] && DOCKER_CMD="$DOCKER_CMD -e GIT_COMMITER_EMAIL=\"${GIT_COMMITER_EMAIL}\""

# Execute the docker command
eval "$DOCKER_CMD ai-ide ${RUNCMD}"

exit 0
