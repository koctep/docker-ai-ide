#!/usr/bin/env python3
"""Append Top-Down workflow events to the SQLite timeline in $TD_TIMELINE_DB.

Each row means "started <type>"; durations are derived later from the
sequence of rows, so nothing here measures time. The timestamp is set by
SQLite itself.

  td-log <type> [--task KEY] [--agent NAME] [--model NAME]
  td-log run test [--task KEY] -- <command> [args...]

TD_TIMELINE_DB unset: nothing is recorded and the command (if any) still runs.
The project is $AI_PROJECT (set by ai-ide), otherwise the git checkout name.
"""

import argparse
import os
import sqlite3
import subprocess
import sys

STEP_TYPES = (
    "requirements", "architecture", "failing_repro", "development",
    "cleanup", "observability", "tech_debt", "dev_docs",
)
IN_STEP_TYPES = ("review", "fix", "blocker_review")
OTHER_TYPES = ("estimation", "commit", "user_wait", "done", "blocked")
# test/test_end are written only by `td-log run test`, which pairs them.
EVENT_TYPES = STEP_TYPES + IN_STEP_TYPES + OTHER_TYPES

SCHEMA = """
CREATE TABLE IF NOT EXISTS events (
  id        INTEGER PRIMARY KEY,
  ts        TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  project   TEXT NOT NULL,
  task_key  TEXT,
  type      TEXT NOT NULL,
  agent     TEXT,
  model     TEXT,
  exit_code INTEGER
)
"""


class LogError(Exception):
    pass


def git(*args):
    try:
        return subprocess.run(
            ["git", *args], capture_output=True, text=True, check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return ""


def project_name():
    # ai-ide mounts every project at /home/src and passes the real name.
    if os.environ.get("AI_PROJECT"):
        return os.environ["AI_PROJECT"]
    # Linked worktrees (e.g. a triage baseline under /tmp) belong to the main
    # checkout, whose .git directory they share.
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if os.path.basename(common) == ".git":
        return os.path.basename(os.path.dirname(common))
    return os.path.basename(git("rev-parse", "--show-toplevel") or os.getcwd())


def record(db_path, task, event_type, agent=None, model=None, exit_code=None):
    try:
        with sqlite3.connect(db_path, timeout=30) as conn:
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute(SCHEMA)
            conn.execute(
                "INSERT INTO events (project, task_key, type, agent, model, exit_code)"
                " VALUES (?, ?, ?, ?, ?, ?)",
                (project_name(), task, event_type, agent, model, exit_code),
            )
        conn.close()
    except sqlite3.Error as exc:
        raise LogError(f"td-log: cannot write {db_path}: {exc}") from exc


def run_test(db_path, task, command):
    logged = True
    if db_path:
        try:
            record(db_path, task, "test")
        except LogError as exc:
            print(exc, file=sys.stderr)
            logged = False
    try:
        code = subprocess.run(command).returncode
    except OSError as exc:
        print(f"td-log: cannot run {command[0]}: {exc}", file=sys.stderr)
        code = 127
    if code < 0:  # killed by a signal
        code = 128 - code
    if db_path and logged:
        try:
            record(db_path, task, "test_end", exit_code=code)
        except LogError as exc:
            print(exc, file=sys.stderr)
    # Logging problems are reported but never replace the test result.
    return code


def parse_args(argv):
    if argv and argv[0] == "run":
        parser = argparse.ArgumentParser(
            prog="td-log run", usage="td-log run test [--task KEY] -- <command> [args...]")
        parser.add_argument("type", choices=["test"])
        parser.add_argument("--task")
        rest = argv[1:]
        if "--" not in rest:
            parser.error("missing -- before the command")
        split = rest.index("--")
        args = parser.parse_args(rest[:split])
        args.command = rest[split + 1:]
        if not args.command:
            parser.error("missing command after --")
        args.run = True
        return args
    parser = argparse.ArgumentParser(
        prog="td-log", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("type", choices=EVENT_TYPES, metavar="type",
                        help="one of: " + ", ".join(EVENT_TYPES))
    parser.add_argument("--task", help="Jira task key; omit for sprint-level events")
    parser.add_argument("--agent", help="CLI that does the work: claude_code, codex, ...")
    parser.add_argument("--model", help="explicitly requested model; omit when unknown")
    args = parser.parse_args(argv)
    args.run = False
    return args


def main(argv):
    args = parse_args(argv)
    db_path = os.environ.get("TD_TIMELINE_DB")
    if args.run:
        return run_test(db_path, args.task, args.command)
    if not db_path:
        return 0
    try:
        record(db_path, args.task, args.type, args.agent, args.model)
    except LogError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
